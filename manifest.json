{
  "manifest_version": 3,
  "name": "Silêncio",
  "version": "2.6.1",
  "description": "Lê UOL, Folha, Globo e New York Times em silêncio: matérias só com o texto, sem scripts, anúncios, popups nem paywall, com resumo pela IA do Chrome.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "browsingData",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.uol.com.br/*",
    "*://*.globo.com/*",
    "*://*.nytimes.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Silêncio",
    "default_icon": {
      "16": "icons/cinza-16.png",
      "32": "icons/cinza-32.png",
      "48": "icons/cinza-48.png",
      "128": "icons/cinza-128.png"
    }
  },
  "icons": {
    "16": "icons/cinza-16.png",
    "32": "icons/cinza-32.png",
    "48": "icons/cinza-48.png",
    "128": "icons/cinza-128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bloqueio",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "leitura.css"
      ],
      "matches": [
        "*://*.uol.com.br/*",
        "*://*.globo.com/*",
        "*://*.nytimes.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.uol.com.br/*",
        "*://*.globo.com/*",
        "*://*.nytimes.com/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN",
      "js": [
        "sem-sw.js"
      ]
    },
    {
      "matches": [
        "*://*.uol.com.br/*",
        "*://*.globo.com/*",
        "*://*.nytimes.com/*"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "sites.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "*://*.uol.com.br/*",
        "*://*.globo.com/*",
        "*://*.nytimes.com/*"
      ],
      "run_at": "document_end",
      "all_frames": false,
      "js": [
        "sites.js",
        "leitura.js"
      ]
    }
  ]
}